<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>by.lab3</groupId>
    <artifactId>lab3-server</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>
    <name>Lab3Server - Tomcat Servlet application</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- Tomcat provides jakarta.servlet.* at runtime. -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.1.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- Достаём котировку из HTML-тега Google Finance. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.24.1</version>
        </dependency>
        <!-- Maven includes this JDBC driver in WEB-INF/lib in the WAR. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.14</version>
        </dependency>
    </dependencies>

    <build>
        <!-- Keep existing sources and web resources in familiar NetBeans folders. -->
        <sourceDirectory>${project.basedir}/src</sourceDirectory>
        <finalName>Lab3Server</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <warSourceDirectory>${project.basedir}/web</warSourceDirectory>
                    <failOnMissingWebXml>true</failOnMissingWebXml>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <!--
        Profile included only when NetBeans Run sets lab3.tomcat.webapps.
        Clean and Build (ordinary package without property) stays portable.
    -->
    <profiles>
        <profile>
            <id>copy-war-to-local-tomcat</id>
            <activation>
                <property>
                    <name>lab3.tomcat.webapps</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>update-tomcat-war</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <echo message="LAB3 DEPLOY: copying Lab3Server.war to ${lab3.tomcat.webapps}" />
                                        <copy file="${project.build.directory}/${project.build.finalName}.war"
                                              todir="${lab3.tomcat.webapps}" overwrite="true" />
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
