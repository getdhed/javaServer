<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <!-- Явно указываем главный класс, чтобы NetBeans не подставлял ${packageClassName}. -->
    <action>
        <actionName>run</actionName>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.6.2:java</goal>
        </goals>
        <properties>
            <exec.mainClass>apacheclient.ApacheClient</exec.mainClass>
        </properties>
    </action>
</actions>
